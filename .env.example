# Configure these variables in your shell or in systemd EnvironmentFile.
# The Go server does not implicitly load .env files.
MF_DATABASE=/var/lib/meu-financeiro/financeiro.db
MF_ADDR=127.0.0.1:8080
MF_ORIGIN=https://financeiro.example.com
MF_FRONTEND=/opt/meu-financeiro/current/frontend/dist
# Only for the administrative provisioning command; unset afterward.
# MF_NAME=
# MF_EMAIL=
# MF_PASSWORD=
